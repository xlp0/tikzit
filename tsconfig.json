{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./src/*"],
      "@clm/mcard-vcs": ["./src/packages/mcard-vcs/index.ts"],
      "@clm/mcard-vcs/*": ["./src/packages/mcard-vcs/*"],
      "@clm/mcard-explorer": ["./src/packages/mcard-explorer/index.ts"],
      "@clm/mcard-explorer/*": ["./src/packages/mcard-explorer/*"]
    },
    "types": ["vite/client", "vitest/globals"],
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist", "node_modules", "build-test"]
}
